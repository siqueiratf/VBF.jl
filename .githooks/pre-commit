#!/usr/bin/env bash
#
# Repo pre-commit hook. Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
# Gates commits that touch the catalog pipeline on .githooks/catalog-check —
# see that script for what it verifies and for the escape hatches.
set -uo pipefail

hooks_dir="$(dirname "${BASH_SOURCE[0]}")"
exec "$hooks_dir/catalog-check" --staged
