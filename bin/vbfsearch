#!/usr/bin/env bash
set -euo pipefail
vbf_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export JULIA_NUM_PRECOMPILE_TASKS=1
exec "${VBF_JULIA:-julia}" --startup-file=no --threads=1,0 --gcthreads=1,0 \
  --project="$vbf_root" "$vbf_root/packages/VBFSearch/tools/vbfsearch.jl" "$@"
