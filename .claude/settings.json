{
  "outputStyle": "ASD-STE100",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.githooks/claude-commit-guard\"",
            "timeout": 600,
            "statusMessage": "Checking catalog gate before commit"
          }
        ]
      }
    ]
  }
}
