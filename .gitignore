# Downloaded catalog originals, import receipts and derived stores.
/.cache/**

# Rebuild inputs and the deterministic catalog live with the package source.
packages/VBFCatalog/src/data/*.sqlite*
!packages/VBFCatalog/src/data/luts/*.gz

# Package-owned generated evidence; preserve directory traversal for READMEs.
# Search hit lists can be larger than 1 GB (selfequiv_class22.hits is 1.27 GB);
# they stay on the local disk only and never enter git or Git LFS.
*.hits
packages/VBFSearch/data/**
!packages/VBFSearch/data/**/
!packages/VBFSearch/data/search/*/parents.tsv
!packages/VBFSearch/data/search/*/replay.toml
packages/VBFRepro/src/results/**
!packages/VBFRepro/src/results/**/
packages/VBFPaper/doc/generated/**
!packages/VBFPaper/doc/generated/**/
packages/VBFPaper/bench/data/**
!packages/VBFPaper/bench/data/**/

# READMEs are always tracked — including the per-paper review summaries under
# packages/VBFRepro/src/<Paper_ID>/README.md. Git resolves a path by the LAST matching
# pattern, so this block must stay at the very bottom of the file: a negation
# placed above a broader pattern is silently overridden by it. Keep new ignore
# rules above this block, and mirror these negations in any nested .gitignore
# that could match a README. Note that a directory-level ignore (e.g.
# `/apn-lib/`) still hides everything inside it — git never descends into it, so
# no negation can rescue a README there. Never ignore a papers/ README that way.
!README.md
!**/README.md
