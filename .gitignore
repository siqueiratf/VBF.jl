# Generated by docs/make.jl from the source docstrings.
docs/src/api/

# Source PDFs of cited papers are copyrighted and never committed.
packages/VBFRepro/src/**/*.pdf

/apn-lib/

# Claude Code — session-local, never committed.
CLAUDE.md
.claude/settings.local.json

# Claude Code planning files — ephemeral, never committed.
**/PLAN.md

# Codex local state, overrides, and secrets. Keep the shared adapter files
# (.codex/config.toml, .codex/agents/, .agents/skills/) tracked.
.codex/*.local.toml
.codex/*secrets*
.codex/auth.json
.codex/sessions/
.codex/logs/
.codex-log/
.env
.env.local
.env.*.local

# Project-scoped Claude Code settings are shared, not personal: they carry the
# PreToolUse guard that keeps a half-updated catalog from reaching CI, so the
# rule has to travel with the checkout. Rescued from the blanket `*.json` above.
# The personal override, .claude/settings.local.json, stays ignored — it is
# matched by its own rule and by `*.json`, and this exact-path negation does not
# touch it.
!.claude/settings.json

# READMEs are always tracked — including the per-paper review summaries under
# packages/VBFRepro/src/<Paper_ID>/README.md. Git resolves a path by the LAST matching
# pattern, so this block must stay at the very bottom of the file: a negation
# placed above a broader pattern is silently overridden by it. Keep new ignore
# rules above this block, and mirror these negations in any nested .gitignore
# that could match a README. Note that a directory-level ignore (e.g.
# `/apn-lib/`) still hides everything inside it — git never descends into it, so
# no negation can rescue a README there. Never ignore a papers/ README that way.
!README.md
!**/README.md
